{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/|src/|@vite/|@react-refresh|@id/|@fs/|assets/|node_modules/|index\\.html).*)", "destination": "/api/render?path=/$1" }
  ],
  "functions": {
    "api/cron/ai-writer.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/ai-writer",
      "schedule": "0 9 * * *"
    }
  ]
}
