# Supabase — obrigatório para autenticação e dados
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ─── Anthropic Claude API ───
# Necessária para a Oficina NZ gerar motores via IA (Fase 3).
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Opcional — modelo Claude a usar. Default: claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Agenda Social → Google Calendar (feed iCal reverso) ───
# Token do endpoint /api/agenda/social-posts-feed. Vai como query param na
# URL que o Google Calendar subscribe (Google não envia headers customizados).
# Gere com: openssl rand -hex 32   (64 chars hex aleatórios)
# Configure também na Vercel → Settings → Environment Variables
# (Production + Preview + Development).
AGENDA_FEED_TOKEN=cole-o-token-aqui

# ─── Supabase service role (necessária para o feed reverso e cron) ───
# Bypassa RLS no servidor. NUNCA exponha no client (sem prefixo VITE_).
# Painel Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------- LOGÍSTICA
# Prazo de entrega na página de produto da LOJA. A LOJA mostra PRAZO, nunca
# valor de frete: o preço é descartado no servidor, em api/logistica/prazo.ts.

# mock  = adapter simulado (padrão, e o que usar enquanto não houver contrato)
# real  = chama Jadlog/Gollog/Melhor Envio de verdade; exige as credenciais abaixo
LOGISTICA_MODO=mock

# Jadlog — token do portal do Embarcador, vinculado ao contrato.
# JADLOG_TOKEN=
# JADLOG_CNPJ=
# JADLOG_CONTA=
# JADLOG_MODALIDADE=3

# Gollog — credencial de cliente.
# GOLLOG_USER=
# GOLLOG_PASSWORD=

# Melhor Envio — intermediador: uma cotação devolve Correios, Jadlog, Azul etc.
# O token é PESSOAL, gerado no painel em Integrações → Permissões de Acesso, com
# as permissões `shipping-calculate` e `shipping-companies`. É exibido uma única
# vez e vale 30 dias (é um JWT; o painel admin mostra a validade lendo o `exp`).
# ⚠️ NUNCA prefixar com VITE_: o token dá acesso à conta de envios da NZ.
# MELHORENVIO_TOKEN=
# E-mail de contato técnico. Vai no header User-Agent, que a API exige.
# MELHORENVIO_UA_EMAIL=
# Trocar para https://sandbox.melhorenvio.com.br para testar sem custo (conta e
# token do sandbox são separados dos de produção).
# MELHORENVIO_ENDPOINT=https://melhorenvio.com.br

# ------------------------------------------------------------ ASAAS (checkout)
# Pix, boleto e cartão da loja (docs/PLANO_CHECKOUT_ASAAS.md). A chave é gerada
# em Integrações → Chaves de API, SEM a permissão de saque. Autenticação é o
# cabeçalho `access_token`.
# ⚠️ NUNCA prefixar com VITE_: a chave cria cobranças e estorna dinheiro.
# ASAAS_API_KEY=
# `sandbox` usa api-sandbox.asaas.com e ASAAS_SANDBOX_API_KEY; padrão: production.
# ASAAS_ENV=production
# ASAAS_SANDBOX_API_KEY=
# Token que o Asaas manda no cabeçalho asaas-access-token do webhook
# (/api/nz/asaas). Gerar com: openssl rand -hex 32 — o mesmo valor vai no
# cadastro do webhook.
# ASAAS_WEBHOOK_TOKEN=

# --------------------------------------------------------- NÃO DOCUMENTADAS
# Já eram lidas pelo código antes desta atualização do .env.example.
# CRON_SECRET=              # protege /api/cron/ai-writer
# GEMINI_API_KEY=           # geração de imagem
# GEMINI_IMAGE_MODEL=
# ANTHROPIC_MODEL_BLOG=
# VITE_EMAILJS_PUBLIC_KEY=
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------ NZERP (ERP)
# Sincronização de catálogo ativo e estoque com o ERP interno, que é um projeto
# Supabase SEPARADO (ipehorttsrvjynnhyzhu).
#
# ⚠️ NUNCA prefixar com VITE_. O NZERP opera com policies `FOR ALL TO public`,
# então a chave dele dá acesso a custo, margem, contas_receber, CRM e RH.
# Colocar isso no bundle do front exporia o sistema interno inteiro.
ERP_SUPABASE_URL=https://ipehorttsrvjynnhyzhu.supabase.co
ERP_SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado do Database Webhook do ERP → /api/nz/webhook.
# Gerar com: openssl rand -hex 32
ERP_WEBHOOK_SECRET=
