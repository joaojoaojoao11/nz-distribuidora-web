# Supabase — obrigatório para autenticação e dados
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ─── Anthropic Claude API ───
# Necessária para a Oficina NZ gerar motores via IA (Fase 3).
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Opcional — modelo Claude a usar. Default: claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Agenda Social → Google Calendar (feed iCal reverso) ───
# Token do endpoint /api/agenda/social-posts-feed. Vai como query param na
# URL que o Google Calendar subscribe (Google não envia headers customizados).
# Gere com: openssl rand -hex 32   (64 chars hex aleatórios)
# Configure também na Vercel → Settings → Environment Variables
# (Production + Preview + Development).
AGENDA_FEED_TOKEN=cole-o-token-aqui

# ─── Supabase service role (necessária para o feed reverso e cron) ───
# Bypassa RLS no servidor. NUNCA exponha no client (sem prefixo VITE_).
# Painel Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------- LOGÍSTICA
# Prazo de entrega na página de produto da LOJA. A LOJA mostra PRAZO, nunca
# valor de frete: o preço é descartado no servidor, em api/logistica/prazo.ts.

# mock  = adapter simulado (padrão, e o que usar enquanto não houver contrato)
# real  = chama Jadlog/Gollog de verdade; exige as credenciais abaixo
LOGISTICA_MODO=mock

# Jadlog — token do portal do Embarcador, vinculado ao contrato.
# JADLOG_TOKEN=
# JADLOG_CNPJ=
# JADLOG_CONTA=
# JADLOG_MODALIDADE=3

# Gollog — credencial de cliente.
# GOLLOG_USER=
# GOLLOG_PASSWORD=

# --------------------------------------------------------- NÃO DOCUMENTADAS
# Já eram lidas pelo código antes desta atualização do .env.example.
# CRON_SECRET=              # protege /api/cron/ai-writer
# GEMINI_API_KEY=           # geração de imagem
# GEMINI_IMAGE_MODEL=
# ANTHROPIC_MODEL_BLOG=
# VITE_EMAILJS_PUBLIC_KEY=
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------ NZERP (ERP)
# Sincronização de catálogo ativo e estoque com o ERP interno, que é um projeto
# Supabase SEPARADO (ipehorttsrvjynnhyzhu).
#
# ⚠️ NUNCA prefixar com VITE_. O NZERP opera com policies `FOR ALL TO public`,
# então a chave dele dá acesso a custo, margem, contas_receber, CRM e RH.
# Colocar isso no bundle do front exporia o sistema interno inteiro.
ERP_SUPABASE_URL=https://ipehorttsrvjynnhyzhu.supabase.co
ERP_SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado do Database Webhook do ERP → /api/erp/webhook.
# Gerar com: openssl rand -hex 32
ERP_WEBHOOK_SECRET=
